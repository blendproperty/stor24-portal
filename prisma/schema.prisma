generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitStatus {
  AVAILABLE
  HELD
  RESERVED
  OCCUPIED
  SERVICE
  UNAVAILABLE
}

enum MapElementType {
  UNIT
  ZONE
  WALL
  FIRE_WALL
  PARTITION_WALL
  DOOR
  WINDOW
  LABEL
  ROLLER_SHUTTER
  SINGLE_DOOR
  DOUBLE_DOOR
  STAIRS
  RETURN_STAIRS
  LIFT
  TABLE
  CHAIR
  CUPBOARD
  ROOF
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  VIEWING_BOOKED
  RESERVED
  WON
  LOST
}

enum TenancyStatus {
  DRAFT
  ACTIVE
  NOTICE_GIVEN
  CLOSED
  CANCELLED
}

enum OccupancyStatus {
  PENDING
  ACTIVE
  TRANSFERRING
  NOTICE_GIVEN
  MOVED_OUT
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  CANCELLED
  EXPIRED
}

enum ReservationJourney {
  RENTAL
  VIEWING
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  CREDIT
  REFUND
  REVERSAL
  WRITE_OFF
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  REVERSED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

enum DailyCloseStatus {
  OPEN
  READY
  CLOSED
  REOPENED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum IntegrationHealthStatus {
  DISCONNECTED
  DISABLED
  CONFIGURED
  CONNECTED
  CONFIG_REQUIRED
  HEALTHY
  DEGRADED
  FAILED
}

enum ReportRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
}

model Organisation {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  timezone               String                  @default("Africa/Johannesburg")
  currency               String                  @default("ZAR")
  facilities             Facility[]
  customers              Customer[]
  users                  User[]
  roles                  Role[]
  tasks                  Task[]
  auditEvents            AuditEvent[]
  integrations           IntegrationConnection[]
  reportSchedules        ReportSchedule[]
  reportRuns              ReportRun[]
  communicationTemplates CommunicationTemplate[]
  communications         CommunicationLog[]
  webhookInbox           WebhookInbox[]
  webhookOutbox          WebhookOutbox[]
  biometricEnrollments   BiometricEnrollment[]
  insurancePlans         InsurancePlan[]
  insuranceEnrollments   InsuranceEnrollment[]
  invitations            UserInvitation[]
  configurationProfiles  ConfigurationProfile[]
  chargeDefinitions      ChargeDefinition[]
  discountPlans          DiscountPlan[]
  products               Product[]
  maintenanceRequests    MaintenanceRequest[]
  unitNotes              UnitNote[]
  dailyCloses            DailyClose[]
  passwordResetTokens    PasswordResetToken[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model UserInvitation {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  name           String
  roleName       String
  facilityCode   String?
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  invitedByName  String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organisationId, status, expiresAt])
  @@index([organisationId, email, status])
}

model Facility {
  id                    String                  @id @default(cuid())
  organisationId        String
  organisation          Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  timezone              String                  @default("Africa/Johannesburg")
  address               Json?
  active                Boolean                 @default(true)
  publicSlug            String?                 @unique
  publicBookingEnabled  Boolean                 @default(false)
  unitTypes             UnitType[]
  units                 Unit[]
  maps                  FacilityMap[]
  leads                 Lead[]
  reservations          Reservation[]
  tenancies             Tenancy[]
  roleAssignments       RoleAssignment[]
  tasks                 Task[]
  integrations          IntegrationConnection[]
  configurationProfiles ConfigurationProfile[]
  products              Product[]
  maintenanceRequests   MaintenanceRequest[]
  unitNotes             UnitNote[]
  dailyCloses           DailyClose[]
  auditEvents           AuditEvent[]
  reportSchedules       ReportSchedule[]
  reportRuns            ReportRun[]
  communications        CommunicationLog[]
  webhookInbox          WebhookInbox[]
  webhookOutbox          WebhookOutbox[]
  biometricEnrollments  BiometricEnrollment[]
  insurancePlans        InsurancePlan[]
  insuranceEnrollments  InsuranceEnrollment[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([organisationId, code])
  @@index([organisationId, active])
}

model UnitType {
  id           String   @id @default(cuid())
  facilityId   String
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name         String
  widthMetres  Decimal? @db.Decimal(8, 2)
  lengthMetres Decimal? @db.Decimal(8, 2)
  areaSqMetres Decimal? @db.Decimal(8, 2)
  features     String[]
  units        Unit[]
  leads        Lead[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([facilityId, name])
}

model Unit {
  id                  String               @id @default(cuid())
  facilityId          String
  facility            Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitTypeId          String
  unitType            UnitType             @relation(fields: [unitTypeId], references: [id])
  number              String
  floor               String?
  zone                String?
  status              UnitStatus           @default(AVAILABLE)
  monthlyRate         Decimal              @db.Decimal(12, 2)
  taxRate             Decimal              @default(0) @db.Decimal(7, 4)
  reservations        Reservation[]
  occupancies         Occupancy[]
  notes               UnitNote[]
  maintenanceRequests MaintenanceRequest[]
  mapElements         MapElement[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([facilityId, number])
  @@index([facilityId, status, unitTypeId])
}

model FacilityMap {
  id            String       @id @default(cuid())
  facilityId    String
  facility      Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name          String
  width         Int          @default(1200)
  height        Int          @default(720)
  backgroundUrl String?
  elements      MapElement[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([facilityId, name])
  @@index([facilityId, updatedAt])
}

model MapElement {
  id        String         @id @default(cuid())
  mapId     String
  map       FacilityMap    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  unitId    String?        @unique
  unit      Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  type      MapElementType
  x         Int
  y         Int
  width     Int
  height    Int
  rotation  Int            @default(0)
  label     String?
  config    Json?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([mapId, type, sortOrder])
}

model Customer {
  id                   String             @id @default(cuid())
  organisationId       String
  organisation         Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  type                 String             @default("INDIVIDUAL")
  firstName            String?
  lastName             String?
  companyName          String?
  email                String?
  phone                String?
  phoneVerifiedAt      DateTime?
  emailVerifiedAt      DateTime?
  identityRef          String?
  taxNumber            String?
  dateOfBirth          DateTime?
  billingAddress       Json?
  emergencyContact     Json?
  alternateContact     Json?
  workContact          Json?
  communicationConsent Json?
  notes                String?
  leads                Lead[]
  reservations         Reservation[]
  tenancies            Tenancy[]
  accounts             Account[]
  tasks                Task[]
  communications       CommunicationLog[]
  biometricEnrollments BiometricEnrollment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([organisationId, email])
  @@index([organisationId, phone])
}

model Lead {
  id                String        @id @default(cuid())
  facilityId        String
  facility          Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  desiredUnitTypeId String?
  desiredUnitType   UnitType?     @relation(fields: [desiredUnitTypeId], references: [id])
  stage             LeadStage     @default(NEW)
  source            String
  notes             String?
  expectedMoveIn    DateTime?
  nextActionAt      DateTime?
  assignedToId      String?
  assignedTo        User?         @relation(fields: [assignedToId], references: [id])
  offlineSubmissionId String?      @unique
  reservations      Reservation[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([facilityId, stage, nextActionAt])
}

model Reservation {
  id                 String            @id @default(cuid())
  facilityId         String
  facility           Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer          @relation(fields: [customerId], references: [id])
  leadId             String?
  lead               Lead?             @relation(fields: [leadId], references: [id])
  unitId             String
  unit               Unit              @relation(fields: [unitId], references: [id])
  status             ReservationStatus @default(ACTIVE)
  journey            ReservationJourney @default(RENTAL)
  quotedRate         Decimal           @db.Decimal(12, 2)
  holdExpiresAt      DateTime?
  intendedMoveIn     DateTime?
  paymentMethod      String?
  viewingAt          DateTime?
  publicReference    String?           @unique
  idempotencyKey     String?           @unique
  source             String            @default("INTERNAL")
  verificationCodeHash String?
  verificationExpiresAt DateTime?
  verificationAttempts Int             @default(0)
  contactVerifiedAt  DateTime?
  convertedTenancyId String?           @unique
  convertedTenancy   Tenancy?          @relation(fields: [convertedTenancyId], references: [id])
  publicPaymentSessions PublicPaymentSession[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([facilityId, status, holdExpiresAt])
  @@index([journey, viewingAt])
}

model PublicPaymentSession {
  id                 String      @id @default(cuid())
  reservationId      String
  reservation        Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status             String      @default("PENDING")
  provider           String      @default("STOR24_SIMULATOR")
  amount             Decimal     @db.Decimal(14, 2)
  currency           String      @default("ZAR")
  description        String
  paymentMethod      String?
  checkoutTokenHash  String
  idempotencyKey     String      @unique
  providerReference  String      @unique
  failureCode        String?
  followUpStatus     String      @default("NOT_STARTED")
  followUpError      String?
  expiresAt          DateTime
  processedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([reservationId, status])
  @@index([status, expiresAt])
}

model Tenancy {
  id          String        @id @default(cuid())
  facilityId  String
  facility    Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  accountId   String        @unique
  account     Account       @relation(fields: [accountId], references: [id])
  status      TenancyStatus @default(DRAFT)
  startDate   DateTime
  paymentMethod String?
  endDate     DateTime?
  noticeDate  DateTime?
  occupancies Occupancy[]
  reservation Reservation?
  documents   Document[]
  insuranceEnrollment InsuranceEnrollment?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([facilityId, status])
  @@index([customerId, status])
}

model Occupancy {
  id          String          @id @default(cuid())
  tenancyId   String
  tenancy     Tenancy         @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit            @relation(fields: [unitId], references: [id])
  status      OccupancyStatus @default(PENDING)
  startDate   DateTime
  endDate     DateTime?
  monthlyRate Decimal         @db.Decimal(12, 2)
  accessState String          @default("PENDING")
  biometricEnrollments BiometricEnrollment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([unitId, status])
  @@index([tenancyId, status])
}

model BiometricEnrollment {
  id                  String       @id @default(cuid())
  organisationId      String
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId          String
  facility            Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  customerId          String
  customer            Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  occupancyId         String
  occupancy           Occupancy    @relation(fields: [occupancyId], references: [id], onDelete: Cascade)
  status              String       @default("PENDING")
  purpose             String       @default("FACILITY_ACCESS")
  consentPolicy       String
  consentAt           DateTime
  consentRecordedById String?
  faceImageSha256     String
  externalPersonId    String?
  externalPersonCode  String?
  providerReference   String?
  provisionedAt       DateTime?
  revokedAt           DateTime?
  retentionUntil      DateTime?
  failureCode         String?
  failureMessage      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([occupancyId, purpose])
  @@index([organisationId, facilityId, status])
  @@index([customerId, status])
}

model InsurancePlan {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  code           String
  name           String
  providerName   String?
  coverageAmount Decimal      @db.Decimal(14, 2)
  monthlyPremium Decimal      @db.Decimal(14, 2)
  excessAmount   Decimal      @default(0) @db.Decimal(14, 2)
  policyVersion  String?
  termsUrl       String?
  active         Boolean      @default(true)
  enrollments    InsuranceEnrollment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, facilityId, code])
  @@index([organisationId, active])
  @@index([facilityId, active])
}

model InsuranceEnrollment {
  id             String         @id @default(cuid())
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tenancyId      String         @unique
  tenancy        Tenancy        @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  planId         String?
  plan           InsurancePlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  status         String
  providerName   String?
  policyVersion  String?
  coverageAmount Decimal?       @db.Decimal(14, 2)
  monthlyPremium Decimal?       @db.Decimal(14, 2)
  excessAmount   Decimal?       @db.Decimal(14, 2)
  effectiveFrom  DateTime?
  endedAt        DateTime?
  acknowledgedAt DateTime
  waiverReason   String?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organisationId, status])
  @@index([facilityId, status])
}

model Account {
  id            String        @id @default(cuid())
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  accountNumber String        @unique
  balance       Decimal       @default(0) @db.Decimal(14, 2)
  currency      String        @default("ZAR")
  tenancy       Tenancy?
  ledgerEntries LedgerEntry[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
}

model LedgerEntry {
  id           String          @id @default(cuid())
  accountId    String
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(14, 2)
  taxAmount    Decimal         @default(0) @db.Decimal(14, 2)
  description  String
  effectiveAt  DateTime
  reversalOfId String?
  externalRef  String?
  metadata     Json?
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())

  @@unique([accountId, externalRef])
  @@index([accountId, effectiveAt])
}

model Payment {
  id             String        @id @default(cuid())
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("ZAR")
  method         String
  provider       String?
  providerRef    String?
  idempotencyKey String        @unique
  failureCode    String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([accountId, status, createdAt])
}

model Document {
  id              String    @id @default(cuid())
  tenancyId       String
  tenancy         Tenancy   @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  type            String
  storageKey      String
  status          String    @default("SIGNED")
  content         String?
  sha256          String?
  signerName      String?
  signerIp        String?
  signerUserAgent String?
  initials        Json?
  clauseVersion   String?
  signingToken    String?   @unique
  provider        String?
  externalId      String?   @unique
  templateKey     String?
  idempotencyKey  String?   @unique
  sentAt          DateTime?
  expiresAt       DateTime?
  signedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([tenancyId, type])
  @@index([provider, externalId])
}

model User {
  id                  String               @id @default(cuid())
  organisationId      String
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email               String
  name                String
  passwordHash        String?
  active              Boolean              @default(true)
  sessionVersion      Int                  @default(0)
  passwordChangedAt   DateTime?
  roleAssignments     RoleAssignment[]
  assignedLeads       Lead[]
  ledgerEntries       LedgerEntry[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreator")
  auditEvents         AuditEvent[]
  unitNotes           UnitNote[]
  maintenanceRequests MaintenanceRequest[]
  stockMovements      StockMovement[]
  dailyCloses         DailyClose[]
  passwordResetTokens PasswordResetToken[]
  reportRuns          ReportRun[]
  mfaCredential       MfaCredential?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([organisationId, email])
}

model MfaCredential {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted    String
  recoveryCodeHashes Json      @default("[]")
  enabledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PasswordResetToken {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, expiresAt])
  @@index([organisationId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Role {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  name           String
  permissions    String[]
  assignments    RoleAssignment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organisationId, name])
}

model RoleAssignment {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@unique([userId, roleId, facilityId])
  @@index([facilityId])
}

model Task {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id])
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(NORMAL)
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId, status, dueAt])
  @@index([assigneeId, status, dueAt])
}

model IntegrationConnection {
  id                  String                  @id @default(cuid())
  organisationId      String
  organisation        Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId          String?
  facility            Facility?               @relation(fields: [facilityId], references: [id])
  category            String
  provider            String
  status              IntegrationHealthStatus @default(DISCONNECTED)
  config              Json
  lastHealthAt        DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int                     @default(0)
  failureCode         String?
  failureMessage      String?
  webhookInbox        WebhookInbox[]
  webhookOutbox       WebhookOutbox[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([organisationId, facilityId, category, provider])
  @@index([organisationId, category])
}

model ConfigurationProfile {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  domain         String
  name           String
  status         String       @default("DRAFT")
  config         Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, facilityId, domain, name])
  @@index([organisationId, domain, status])
}

model ChargeDefinition {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  amount         Decimal?     @db.Decimal(14, 2)
  calculation    String       @default("FIXED")
  taxable        Boolean      @default(true)
  active         Boolean      @default(true)
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, code])
}

model DiscountPlan {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  discountType   String
  value          Decimal      @db.Decimal(14, 4)
  active         Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  rules          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, code])
}

model UnitNote {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitId         String
  unit           Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  note           String
  pinned         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId, facilityId, createdAt])
  @@index([unitId, createdAt])
}

model MaintenanceRequest {
  id             String            @id @default(cuid())
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitId         String?
  unit           Unit?             @relation(fields: [unitId], references: [id])
  assignedToId   String?
  assignedTo     User?             @relation(fields: [assignedToId], references: [id])
  title          String
  description    String?
  status         MaintenanceStatus @default(OPEN)
  priority       TaskPriority      @default(NORMAL)
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organisationId, facilityId, status, dueAt])
  @@index([unitId, status])
}

model Product {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  category       String
  barcode        String?
  costPrice      Decimal         @default(0) @db.Decimal(14, 2)
  sellingPrice   Decimal         @db.Decimal(14, 2)
  quantityOnHand Int             @default(0)
  reorderPoint   Int             @default(0)
  active         Boolean         @default(true)
  movements      StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([facilityId, sku])
  @@index([organisationId, facilityId, active])
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        StockMovementType
  quantity    Int
  unitCost    Decimal?          @db.Decimal(14, 2)
  reason      String?
  reference   String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
}

model DailyClose {
  id             String           @id @default(cuid())
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String
  facility       Facility         @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  businessDate   DateTime         @db.Date
  status         DailyCloseStatus @default(OPEN)
  checks         Json
  expectedCash   Decimal          @default(0) @db.Decimal(14, 2)
  countedCash    Decimal?         @db.Decimal(14, 2)
  variance       Decimal?         @db.Decimal(14, 2)
  notes          String?
  closedById     String?
  closedBy       User?            @relation(fields: [closedById], references: [id])
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([facilityId, businessDate])
  @@index([organisationId, status, businessDate])
}

model ReportSchedule {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  reportKey      String
  name           String
  parameters     Json
  format         String       @default("CSV")
  cronExpression String
  timezone       String       @default("Africa/Johannesburg")
  recipients     String[]
  permission     String
  active         Boolean      @default(false)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  runs           ReportRun[]

  @@index([organisationId, active, nextRunAt])
  @@index([facilityId, reportKey])
}

model ReportRun {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?       @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  scheduleId     String?
  schedule       ReportSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  requestedById  String?
  requestedBy    User?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  reportKey      String
  parameters     Json
  format         String
  status         ReportRunStatus @default(QUEUED)
  rowCount       Int?
  storageKey     String?
  failureCode    String?
  failureMessage String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([organisationId, status, createdAt])
  @@index([scheduleId, createdAt])
}

model CommunicationTemplate {
  id             String             @id @default(cuid())
  organisationId String
  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  channel        String
  subject        String?
  body           String
  variables      String[]
  version        Int                @default(1)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  communications CommunicationLog[]

  @@unique([organisationId, key, version])
  @@index([organisationId, channel, active])
}

model CommunicationLog {
  id             String                 @id @default(cuid())
  organisationId String
  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?              @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  templateId     String?
  template       CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel        String
  direction      String                 @default("OUTBOUND")
  messageType    String?
  recipientHash  String
  provider       String?
  providerRef    String?
  status         DeliveryStatus         @default(PENDING)
  idempotencyKey String                 @unique
  failureCode    String?
  failureMessage String?
  queuedAt       DateTime               @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  attempts       Int                    @default(1)
  nextRetryAt    DateTime?
  optedOutAt     DateTime?
  metadata       Json?

  @@index([organisationId, status, queuedAt])
  @@index([customerId, queuedAt])
  @@index([providerRef])
  @@index([organisationId, channel, queuedAt])
}

model WebhookInbox {
  id              String                 @id @default(cuid())
  organisationId  String
  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId      String?
  facility        Facility?              @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  connectionId    String?
  connection      IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider        String
  eventType       String
  externalEventId String
  payload         Json
  headers         Json?
  status          DeliveryStatus         @default(PENDING)
  attempts        Int                    @default(0)
  nextAttemptAt   DateTime?
  processedAt     DateTime?
  failureCode     String?
  failureMessage  String?
  receivedAt      DateTime               @default(now())

  @@unique([organisationId, provider, externalEventId])
  @@index([organisationId, status, nextAttemptAt])
}

model WebhookOutbox {
  id             String                 @id @default(cuid())
  organisationId String
  organisation   Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?              @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  connectionId   String?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  eventType      String
  aggregateType  String
  aggregateId    String
  destination    String
  payload        Json
  idempotencyKey String                 @unique
  status         DeliveryStatus         @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  responseStatus Int?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime               @default(now())

  @@index([organisationId, status, nextAttemptAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  requestId      String?
  ipHash         String?
  occurredAt     DateTime     @default(now())

  @@index([organisationId, facilityId, entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
}
