DATABASE_URL="postgresql://stor24:stor24@localhost:5432/stor24_crm?schema=public"
APP_URL="http://localhost:3000"
APP_HOST="stor24-site.srv938083.hstgr.cloud"
APP_PORT="3014"
AUTH_SECRET="replace-with-a-long-random-value"
BOOTSTRAP_TOKEN_HASH="sha256-hash-of-one-time-owner-setup-token"
# Email provider: "resend", "sendgrid", "twilio", or unset/anything else to disable.
EMAIL_PROVIDER="resend"
EMAIL_FROM="Stor24 CRM <no-reply@example.com>"
RESEND_API_KEY="replace-with-provider-api-key"
# Only needed if EMAIL_PROVIDER=sendgrid. Requires a verified sender or domain in the SendGrid console.
# NOTE: this is api.sendgrid.com and needs its own SG.-prefixed API key from
# app.sendgrid.com — it is NOT the same product as EMAIL_PROVIDER=twilio below,
# and a Twilio Account SID will not work here (causes a 401).
SENDGRID_API_KEY=""
# Twilio — used for SMS and WhatsApp reservation-confirmation notifications,
# and optionally for email (EMAIL_PROVIDER=twilio, via the newer Twilio Email
# API at comms.twilio.com). Account SID and Auth Token come from the Twilio
# Console dashboard.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# An SMS-capable Twilio number, e.g. "+15551234567". On a trial account, SMS
# only delivers to numbers verified under Phone Numbers > Verified Caller IDs.
TWILIO_SMS_FROM=""
# The Twilio WhatsApp sender number (no "whatsapp:" prefix — the code adds it).
# Before WhatsApp Business approval this is Twilio's shared sandbox number,
# and each recipient must first WhatsApp the sandbox join code to opt in.
TWILIO_WHATSAPP_FROM=""
# Approved Twilio Content Template SID used by the owner-only WhatsApp connection test.
TWILIO_WHATSAPP_TEST_CONTENT_SID=""
TWILIO_WHATSAPP_RESERVATION_CONFIRMED_SID=""
TWILIO_WHATSAPP_PAYMENT_RECEIVED_SID=""
TWILIO_WHATSAPP_MOVE_IN_REMINDER_SID=""
TWILIO_WHATSAPP_ACCESS_READY_SID=""
TWILIO_WHATSAPP_PAYMENT_REMINDER_SID=""
TWILIO_WHATSAPP_PAYMENT_OVERDUE_SID=""
TWILIO_WHATSAPP_MOVE_OUT_CONFIRMATION_SID=""
# Keep false until consent, callbacks, templates and opt-out pass production UAT.
WHATSAPP_AUTOMATION_ENABLED="false"
# Only used if EMAIL_PROVIDER=twilio. Optional during the trial — if unset,
# the code sends from the auto-provisioned "{TWILIO_ACCOUNT_SID}@twilio.email"
# sandbox address, which needs no domain verification. Set this once a real
# sending domain has been authenticated in the Twilio console.
TWILIO_EMAIL_FROM=""
WEBHOOK_SOURCE=""
WEBHOOK_ORGANISATION_ID=""
# Store only a SHA-256 digest of the inbound webhook key.
WEBHOOK_KEY_SHA256=""
POSTGRES_DB="stor24_crm"
POSTGRES_USER="stor24"
POSTGRES_PASSWORD="replace-with-a-long-random-value"
ALLOW_SYNTHETIC_DEMO_SEED="false"
# Server-to-server key used by the public Stor24 website. Keep this server-only.
PUBLIC_BOOKING_API_KEY="replace-with-a-long-random-value"
# How long a website reservation holds an available unit before staff action.
PUBLIC_RESERVATION_HOLD_HOURS="48"
# Store only a SHA-256 digest of the monthly billing cron key (same
# convention as WEBHOOK_KEY_SHA256 above — never store the raw key here).
# This authenticates POST /api/v1/billing/run-monthly, which an external
# cron job on the VPS must call once a month to generate recurring rent
# charges (there is no in-app scheduler for this yet). Add a crontab entry
# on the VPS like:
#   0 2 1 * * curl -sf -X POST https://<host>/api/v1/billing/run-monthly \
#     -H "x-cron-key: <the raw, un-hashed secret>" \
#     -H "Content-Type: application/json" -d '{}'
BILLING_CRON_SECRET_SHA256=""
# HikCentral OpenAPI biometric access. Keep APP_SECRET server-side only.
HIKCENTRAL_BASE_URL=
HIKCENTRAL_APP_KEY=
HIKCENTRAL_APP_SECRET=
# JSON map keyed by CRM facility ID: {"facility-id":{"organisationIndexCode":"...","doorIndexCodes":["..."]}}
HIKCENTRAL_FACILITY_CONFIG_JSON=
# Override only when the installed HikCentral OpenAPI guide uses different versioned paths.
HIKCENTRAL_PERSON_ADD_PATH=/artemis/api/resource/v1/person/single/add
HIKCENTRAL_FACE_ADD_PATH=/artemis/api/resource/v1/face/single/add
HIKCENTRAL_PERMISSION_ADD_PATH=/artemis/api/acps/v1/auth_config/add
HIKCENTRAL_PERMISSION_DELETE_PATH=/artemis/api/acps/v1/auth_config/delete
HIKCENTRAL_DOOR_SEARCH_PATH=/artemis/api/resource/v1/acsDoor/advance/acsDoorList

# Blend Sign server-to-server lease creation. Keep both secrets server-only.
BLENDSIGN_BASE_URL=https://blendsign.srv938083.hstgr.cloud
BLENDSIGN_API_KEY=
BLENDSIGN_WEBHOOK_SECRET=
