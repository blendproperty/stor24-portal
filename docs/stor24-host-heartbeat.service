[Unit]
Description=STOR24 local backup/resource checks and outbound monitoring heartbeat
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/stor24-monitor/current
ExecStart=/usr/bin/node /opt/stor24-monitor/current/scripts/host-heartbeat.mjs
TimeoutStartSec=130
UMask=0077
