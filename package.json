{
  "name": "stor24-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:guides": "node scripts/build-offline-guide.mjs && node scripts/test-guided-help.mjs",
    "predev": "node scripts/build-offline-guide.mjs",
    "prebuild": "node scripts/build-offline-guide.mjs && node scripts/generate-pwa-service-worker.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "migration:validate": "node scripts/validate-migration-export.mjs",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.5",
    "lucide-react": "^1.27.0",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.4",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
